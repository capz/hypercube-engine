<Project>
  <PropertyGroup>
    <Version Condition="'$(Version)' == ''">0.1.0-preview.1</Version>
    <Authors>capz and Hypercube contributors</Authors>
    <PackageProjectUrl>https://github.com/capz/hypercube-engine</PackageProjectUrl>
    <RepositoryUrl>https://github.com/capz/hypercube-engine</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>GPL-2.0-only</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>GameCube;Hypercube;DolphinDotNet;gamedev;engine</PackageTags>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../LICENSE" Pack="true" PackagePath="/" />
    <None Include="$(MSBuildThisFileDirectory)package-readme.md" Pack="true" PackagePath="/README.md" />
  </ItemGroup>
</Project>
