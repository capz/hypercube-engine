<Project>
  <PropertyGroup>
    <DndBuildNative Condition="'$(DndBuildNative)' == ''">false</DndBuildNative>
    <IsPackable>false</IsPackable>
    <DolphinDotNetPackageVersion>0.1.0-preview.328.1</DolphinDotNetPackageVersion>
    <HypercubeNativePasses Condition="'$(HypercubeNativePasses)' == ''">true</HypercubeNativePasses>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DolphinDotNetRoot Condition="'$(DolphinDotNetRoot)' == '' And Exists('$(MSBuildThisFileDirectory)vendor/sdk/sdk/DolphinDotNet.Sdk/Sdk/Sdk.props')">$(MSBuildThisFileDirectory)vendor/sdk</DolphinDotNetRoot>
    <DolphinDotNetRoot Condition="'$(DolphinDotNetRoot)' == ''">$(MSBuildThisFileDirectory)../DolphinDotNet</DolphinDotNetRoot>
  </PropertyGroup>
</Project>
